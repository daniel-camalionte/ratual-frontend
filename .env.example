# Nunca coloque segredos aqui: tudo que comeca com VITE_ vai para o bundle e e PUBLICO.
# Base da API (mesma origem). Em dev o Vite faz proxy de /api para http://127.0.0.1:8000.
VITE_API_BASE=/api

# Ligue (true) quando o backend tiver /v1/auth/login. Enquanto false, o app usa um usuario de demonstracao.
VITE_AUTH_ENABLED=false
