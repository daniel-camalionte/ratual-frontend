# Apache (KingHost). Enviado junto com o conteudo de dist/ para a pasta publica (www / public_html).

Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Endereco principal: www.ratual.com.br (o cookie de login e o Redirect URL do eWeLink valem so para ele).
  # Atencao: POST em redirect 301 vira GET; a cron deve chamar direto https://www.ratual.com.br/api/...
  RewriteCond %{HTTP_HOST} ^ratual\.com\.br$ [NC]
  RewriteRule ^ https://www.ratual.com.br%{REQUEST_URI} [L,R=301]

  # Sempre HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /api e do backend (mod_wsgi): nunca reescrever
  RewriteRule ^api(/|$) - [L]

  # SPA: qualquer rota que nao seja arquivo/pasta cai no index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # CSP: so recursos do proprio dominio, exceto o video HLS das cameras (hosts da EZVIZ; blob: e do MediaSource do hls.js).
  # Se o player de camera falhar em producao, veja o console: a violacao de CSP informa o host a liberar.
  # CSP: so recursos do proprio dominio. 'unsafe-inline' APENAS em estilos (ApexCharts e atributos style);
  # scripts inline continuam bloqueados. Se um dia usar CDN/analytics, adicione o dominio aqui de forma explicita.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.ezvizlife.com https://*.ezviz.com https://*.ys7.com; media-src 'self' blob: https://*.ezvizlife.com https://*.ezviz.com https://*.ys7.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

  # index.html nunca em cache (aponta para os arquivos com hash do build atual)
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Nao expor arquivos sensiveis
<FilesMatch "^\.(?!htaccess$)|\.(map|env|log|md)$">
  Require all denied
</FilesMatch>
